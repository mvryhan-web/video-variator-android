# Video Uniquifier production / HTTPS
PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.example
APP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
CORS_ORIGIN=https://your-domain.example
WEB_VERSION=5.0.0
ANDROID_VERSION=5.0.0
ANDROID_VERSION_CODE=5
LATEST_APK_URL=https://github.com/mvryhan-web/video-variator-android/releases/download/latest/VideoUniquifier.apk

# Administrator access
# Set this only in the production environment. Do not commit the real administrator Gmail address.
ADMIN_EMAIL=

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/video_uniquifier
DATABASE_SSL=true

# Google Identity Services
# Create a production OAuth Web client for the HTTPS APP_URL and add that origin in Google Cloud Console.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Sign in with Apple (web Services ID)
APPLE_CLIENT_ID=com.example.videouniquifier.web
APPLE_REDIRECT_URI=https://your-domain.example/auth/apple/callback

# Stripe
# Basic = 750 credits, Pro = 2250 credits, Business = 15000 credits. Lifetime = unlimited permanent access after a one-time EUR 2999 payment. 1 processed second = 1 credit per generated variation.
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_BASIC=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx
STRIPE_PRICE_LIFETIME=price_xxx

# Optional first-subscription coupon created in Stripe
STRIPE_FIRST_SUBSCRIPTION_COUPON_ID=
INTRO_OFFER_TEXT=Intro discount available on your first subscription

# Android GitHub repository variables (configure in repository settings, not in this file):
# VV_WEB_APP_URL=https://your-domain.example
# VV_API_BASE_URL=https://your-domain.example
# VV_UPDATE_API_URL=https://your-domain.example/api/version
