# Video Uniquifier production / HTTPS
PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.example
APP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
CORS_ORIGIN=https://your-domain.example
WEB_VERSION=5.0.0
ANDROID_VERSION=5.0.0
ANDROID_VERSION_CODE=5
LATEST_APK_URL=https://github.com/mvryhan-web/video-variator-android/releases/download/latest/VideoUniquifier.apk

# Administrator access
# Set this only in the production environment. Do not commit the real administrator Gmail address.
ADMIN_EMAIL=

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/video_uniquifier
DATABASE_SSL=true

# Google Identity Services
# Create a production OAuth Web client for the HTTPS APP_URL and add that origin in Google Cloud Console.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Sign in with Apple (web Services ID)
APPLE_CLIENT_ID=com.example.videouniquifier.web
APPLE_REDIRECT_URI=https://your-domain.example/auth/apple/callback

# Stripe
# Basic = 750 credits, Pro = 2250 credits, Business = 15000 credits. Lifetime = unlimited permanent access after a one-time EUR 2999 payment. 1 processed second = 1 credit per generated variation.
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_BASIC=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx
STRIPE_PRICE_LIFETIME=price_xxx

# Optional first-subscription coupon created in Stripe
STRIPE_FIRST_SUBSCRIPTION_COUPON_ID=
INTRO_OFFER_TEXT=Intro discount available on your first subscription

# Android GitHub repository variables (configure in repository settings, not in this file):
# VV_WEB_APP_URL=https://your-domain.example
# VV_API_BASE_URL=https://your-domain.example
# VV_UPDATE_API_URL=https://your-domain.example/api/version


# Deepsyq staged rollout
# Keep OFF until the feature branch passes release gates.
DEEPSYQ_HOME_ENABLED=false

# Owner-only AI Studio pilot
# Provider keys are server secrets. Leave empty in committed files.
AI_STUDIO_ENABLED=false
AI_STUDIO_ALLOWED_KINDS=
AI_STUDIO_ALLOWED_MODELS=
AI_STUDIO_MAX_CALLS=0
# Owner-only DB controls for model enable/disable/maintenance/priority/markup. Keep OFF until reviewed.
AI_PROVIDER_ADMIN_ENABLED=false
# Server-side pre-dispatch model selection only. Does not retry ambiguous paid provider calls.
AI_SMART_ROUTING_ENABLED=false
# Commercial AI wallet reservation/capture wiring. Keep OFF until pricing and public entitlement gates are approved.
AI_STUDIO_WALLET_ENABLED=false
# Server-side abuse/concurrency gates for future public AI access.
AI_STUDIO_PUBLIC_POLICY_ENABLED=false
AI_STUDIO_MAX_CONCURRENT_PER_USER=2
AI_STUDIO_MAX_JOBS_PER_HOUR=20
# Poll only already-created async provider task IDs after restart; does not create retry generations.
AI_STUDIO_BACKGROUND_POLLING=false
AI_STUDIO_POLL_INTERVAL_MS=15000
# Production object storage for generated media. Keep OFF until bucket credentials are configured.
AI_OBJECT_STORAGE_ENABLED=false
AI_OBJECT_STORAGE_ENDPOINT=https://objects.example.com
AI_OBJECT_STORAGE_BUCKET=
AI_OBJECT_STORAGE_REGION=auto
AI_OBJECT_STORAGE_ACCESS_KEY_ID=
AI_OBJECT_STORAGE_SECRET_ACCESS_KEY=
AI_OBJECT_STORAGE_PREFIX=deepsyq
# Owner-only reference MP4/WAV HTTP upload pilot; requires enabled Studio, private S3, ledger migration, cleanup worker and staging/TTL flags.
# Never enable public media uploads before independent codec/malware scanning and provider transport review.
AI_STUDIO_REFERENCE_UPLOAD_ENABLED=false
AI_STUDIO_REFERENCE_STAGING_ENABLED=false
AI_STUDIO_REFERENCE_CLEANUP_ENABLED=false
AI_STUDIO_REFERENCE_TTL_MINUTES=
# Server-only offline WAV payload preparation, not an API route or approval for paid calls.
# Both must remain false until media security, validated visual refs, credits, and consent are reviewed.
AI_STUDIO_REFERENCE_AUDIO_PAYLOAD_ENABLED=false
AI_STUDIO_REFERENCE_TRANSFER_REVIEW_APPROVED=false
# Server-only sensitive presigned S3 GET preparation; never returned through HTTP.
# Owner-approved provider fetch hosts must exactly match the configured HTTPS S3 endpoint.
# Do not activate before real provider-fetch timing, privacy, rights, consent & pricing review.
AI_STUDIO_REFERENCE_VIDEO_PRESIGN_ENABLED=false
AI_STUDIO_REFERENCE_PROVIDER_FETCH_HOSTS=
GEMINI_API_KEY=
BYTEPLUS_API_KEY=
# Exact approved BytePlus/Volcengine CDN hostnames, comma-separated. No wildcards.
BYTEPLUS_MEDIA_HOSTS=

# AI generation pricing
# JSON array of explicitly approved model price rows.
# Example shape only (do not copy numbers as production economics):
# [{"model":"provider-model-id","provider":"Provider","kind":"video","credits":100,"providerCostMicros":250000,"currency":"usd","ratio":"16:9","quality":"720p","durationSeconds":5}]
AI_MODEL_PRICING_JSON=[]

# Separate prepaid AI credit packs/rates. Existing Stripe subscriptions remain intact.
# Default stays disabled. For live AI credit checkout, ALL of these are required:
# AI_BILLING_ENABLED=true + AI_BILLING_MODE=live + AI_LIVE_BILLING_APPROVED=true + a live Stripe key.
AI_BILLING_ENABLED=false
AI_BILLING_MODE=test
AI_LIVE_BILLING_APPROVED=false
AI_CREDIT_PACKS_JSON=[]
AI_CREDIT_RATES_JSON=[]

# Optional AI credits on CONFIRMED paid legacy Basic/Pro/Business subscription invoices.
# Disabled by default. Never reuse old video-tool allowances as AI credits.
# Set only after owner approves exact AI unit economics; JSON values must be
# positive integers keyed basic/pro/business. Existing STRIPE_PRICE_* must match
# the PAID Stripe invoice line and existing DB subscription/customer.
# Signed Stripe invoice.paid grants once per invoice; not on frontend success.
# For live Stripe: AI_BILLING_MODE=live AND AI_LIVE_BILLING_APPROVED=true.
AI_SUBSCRIPTION_CREDITS_ENABLED=false
AI_SUBSCRIPTION_CREDITS_JSON={}

# Owner-only audited manual AI wallet adjustments. Keep OFF until operational policy is approved.
AI_OWNER_CREDIT_ADJUSTMENTS=false

# Deepsyq BASE feature rollout. Production defaults to disabled unless explicitly true.
AI_APPS_ENABLED=false
# Block 3: owner-approved Inspiration gallery. No examples are seeded automatically.
AI_INSPIRATION_ENABLED=false
# Keep OFF until the user-facing Agent from Block 2 really exists and consumes `deepsyq_agent_inspiration_start`.
AI_INSPIRATION_AGENT_TARGETS_ENABLED=false
# Same-origin path to the real Agent UI, e.g. /agent.html. Blank keeps Agent-target inspiration hidden even if the flag is set.
AI_INSPIRATION_AGENT_PATH=
AI_ONBOARDING_ENABLED=false

# Public AI generation rollout. Keep OFF until live provider economics, AI wallet and entitlements are approved.
AI_PUBLIC_GENERATION_ENABLED=false
# BASE #50 — OPTIONAL independent kill switches. Unset = existing behavior;
# explicit 'false' (or invalid value) disables only NEW matching jobs/quotes.
# Existing history and queued job recovery are not disabled. The global public
# generation gate remains OFF until independently approved.
# AI_IMAGE_ENABLED=false
# AI_VIDEO_ENABLED=false
# BYTEPLUS_ENABLED=false
# No default plan limits are invented. Example shape only:
# AI_PLAN_ENTITLEMENTS_JSON=[{"plan":"basic","maxConcurrent":1,"maxPerHour":10}]
AI_PLAN_ENTITLEMENTS_JSON=[]

# Optional one-time acquisition grant. OFF/0 by default; approve an exact amount before enabling.
AI_WELCOME_CREDITS_ENABLED=false
AI_WELCOME_CREDITS=0
